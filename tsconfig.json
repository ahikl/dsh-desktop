{
  // The `paths` block is ONLY for developing inside the dsh monorepo checkout:
  // it maps the dsh framework packages to their source so typechecking and
  // tests resolve without npm-published copies. When the dsh family is
  // published, drop `paths` and list the packages as devDependencies instead.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"],
    "paths": {
      "commander": ["../node_modules/.pnpm/commander@15.0.0/node_modules/commander/typings/index.d.ts"],
      "@deepseek-ai/cordis": ["../vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/schemastery": ["../vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/cordis-plugin-loader": ["../vendor/loader/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-cmdline": ["../packages/boot/cmdline/lib/types/index.d.ts"]
    }
  },
  "include": ["src"]
}
